generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum UserRole {
  CUSTOMER
  BOUTIQUE_OWNER
  ADMIN
}

enum BoutiqueStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductCategory {
  ETHNIC_WEAR
  WESTERN_WEAR
  FORMAL_WEAR
  PARTY_WEAR
  BRIDAL_WEAR
  ACCESSORIES
  FOOTWEAR
  OTHER
}

enum RentalPricingUnit {
  PER_DAY
  PER_RENTAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PICKED_UP
  RETURNED
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

enum InspectionCondition {
  GOOD
  MINOR_DAMAGE
  MAJOR_DAMAGE
}

enum ManualRefundStatus {
  PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  WITHHELD
  NOT_REQUIRED
}

enum BookingEventAction {
  CREATED
  CONFIRMED
  REJECTED
  CANCELLED
  PICKED_UP
  RETURNED
  COMPLETED
  INSPECTION_RECORDED
  REFUND_UPDATED
  NOTE_ADDED
  EXPIRED
}

enum BoutiqueReviewAction {
  APPROVED
  REJECTED
  REOPENED
}

enum InventoryUnitStatus {
  READY
  WITH_CUSTOMER
  INSPECTION_REQUIRED
  CLEANING
  REPAIR
  LOST
  RETIRED
}

enum InventoryUnitBlockType {
  BOOKING
  OFFLINE
  MAINTENANCE
}

// ---------- AUTHENTICATION ----------

model User {
  id            String    @id @default(cuid())
  name          String?   @db.VarChar(120)
  email         String?   @unique @db.VarChar(254)
  emailVerified DateTime? @db.Timestamptz(6)
  image         String?   @db.Text

  // Used by email/password authentication.
  // Nullable because Google OAuth users need not have a password.
  passwordHash String? @db.VarChar(255)

  role     UserRole @default(CUSTOMER)
  phone    String?  @db.VarChar(32)
  isActive Boolean  @default(true)
  sessionVersion Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  accounts            Account[]
  sessions            Session[]
  boutique            Boutique?             @relation("BoutiqueOwner")
  boutiqueReviews     BoutiqueReviewEvent[] @relation("BoutiqueReviewEventReviewer")
  bookings            Booking[]             @relation("BookingCustomer")
  bookingEvents       BookingEvent[]        @relation("BookingActor")
  inspectionsRecorded BookingInspection[]   @relation("InspectionRecorder")
  refundsRecorded     ManualRefundRecord[]  @relation("RefundRecorder")
  wishlistItems       Wishlist[]
  reviews             Review[]
  reviewedBoutiques   Boutique[]            @relation("BoutiqueReviewedBy")
  auditLogs           AuditLog[]
  authTokens          AuthToken[]
  basketItems         BasketItem[]
  bookingQuotes       BookingQuote[]
  notifications       Notification[]
  supportRequests     SupportRequest[]
  inventoryUnitEvents InventoryUnitEvent[] @relation("InventoryUnitEventActor")
  inventoryUnitBlocks InventoryUnitBlock[] @relation("InventoryUnitBlockActor")

  @@index([role, isActive])
  @@index([createdAt])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String @db.VarChar(50)
  provider          String @db.VarChar(100)
  providerAccountId String @db.VarChar(191)

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String? @db.VarChar(100)
  scope         String? @db.Text
  id_token      String? @db.Text
  session_state String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @db.VarChar(255)
  userId       String
  expires      DateTime @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String   @db.VarChar(254)
  token      String   @unique @db.VarChar(255)
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@index([expires])
}

// ---------- BOUTIQUE MANAGEMENT ----------

model Boutique {
  id      String @id @default(cuid())
  ownerId String @unique

  name         String            @db.VarChar(120)
  description  String            @db.Text
  contactEmail String            @db.VarChar(254)
  phone        String            @db.VarChar(32)
  address      String            @db.VarChar(300)
  city         String            @db.VarChar(120)
  state        String            @db.VarChar(120)
  postalCode   String            @db.VarChar(12)
  categories   ProductCategory[]
  socialLink   String?           @db.VarChar(300)
  openingHours String            @default("") @db.VarChar(1000)
  collectionInstructions String @default("") @db.VarChar(2000)
  cancellationPolicy String @default("") @db.VarChar(2000)
  returnPolicy String @default("") @db.VarChar(2000)
  rentalPolicy String            @default("") @db.VarChar(3000)

  status          BoutiqueStatus @default(PENDING)
  rejectionReason String?        @db.Text
  submittedAt     DateTime       @default(now()) @db.Timestamptz(6)
  reviewedAt      DateTime?      @db.Timestamptz(6)
  reviewedById    String?
  timezone        String         @default("Asia/Kolkata") @db.VarChar(64)
  version         Int            @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  owner      User  @relation("BoutiqueOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("BoutiqueReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewEvents BoutiqueReviewEvent[]
  products     Product[]
  bookings     Booking[]

  @@index([status, submittedAt])
  @@index([city, state, status])
  @@index([reviewedById])
}

model BoutiqueReviewEvent {
  id         String               @id @default(cuid())
  boutiqueId String
  reviewerId String
  action     BoutiqueReviewAction
  reason     String?              @db.Text
  createdAt  DateTime             @default(now()) @db.Timestamptz(6)

  boutique Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  reviewer User     @relation("BoutiqueReviewEventReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([boutiqueId, createdAt])
  @@index([reviewerId, createdAt])
}

// ---------- PRODUCT CATALOG ----------

model Product {
  id         String @id @default(cuid())
  boutiqueId String

  name         String          @db.VarChar(120)
  description  String          @db.Text
  category     ProductCategory
  categoryId   String?
  catalogCategory Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  occasionTags String[]        @default([])
  colours      String[]        @default([])
  fabricStyle  String          @db.VarChar(200)
  garmentType  String          @default("other") @db.VarChar(40)
  includedPieces String[]      @default([])

  // Prices are integer paise, never floating-point currency.
  rentalPriceMinor BigInt
  rentalPriceUnit  RentalPricingUnit @default(PER_DAY)
  depositMinor     BigInt            @default(0)

  archived Boolean @default(false)
  version  Int     @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  boutique      Boutique         @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  variants      ProductVariant[]
  images        ProductImage[]
  wishlistItems Wishlist[]
  reviews       Review[]

  @@index([boutiqueId, archived, createdAt])
  @@index([category, archived])
  @@index([categoryId, archived])
  @@index([archived, createdAt])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  // Example: S, M, L, XL, UK-8.
  size     String  @db.VarChar(80)
  sku      String? @unique @db.VarChar(100)
  quantity Int
  measurements String @default("") @db.VarChar(1000)

  // Optional overrides for this size/SKU.
  rentalPriceMinor BigInt?
  depositMinor     BigInt?

  archived Boolean @default(false)
  version  Int     @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]
  basketItems BasketItem[]
  inventoryUnits InventoryUnit[]

  @@unique([productId, size])
  @@index([productId, archived])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  publicId  String   @db.VarChar(255)
  secureUrl String   @db.Text
  alt       String   @db.VarChar(160)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([productId])
}

// ---------- RENTAL BOOKINGS ----------

model Booking {
  id         String        @id @default(cuid())
  boutiqueId String
  customerId String
  status     BookingStatus @default(PENDING)

  // Rental interval: pickupAt inclusive, returnAt exclusive.
  pickupAt DateTime @db.Timestamptz(6)
  returnAt DateTime @db.Timestamptz(6)

  rentalMinor  BigInt
  depositMinor BigInt @default(0)
  currency     String @default("INR") @db.VarChar(3)

  rejectionReason    String? @db.Text
  cancellationReason String? @db.Text

  pickedUpAt  DateTime? @db.Timestamptz(6)
  returnedAt  DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  requestExpiresAt DateTime? @db.Timestamptz(6)
  stockReadyAt DateTime? @db.Timestamptz(6)
  turnaroundMinutes Int @default(0)
  requestKey String? @db.VarChar(100)
  policySnapshot Json?

  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  boutique     Boutique            @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  customer     User                @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  items        BookingItem[]
  events       BookingEvent[]
  inspection   BookingInspection?
  refundRecord ManualRefundRecord?
  reviews      Review[]
  notifications Notification[]
  supportRequests SupportRequest[]

  @@index([customerId, createdAt])
  @@index([boutiqueId, status, createdAt])
  @@index([status, pickupAt, returnAt])
  @@index([boutiqueId, pickupAt, returnAt])
  @@unique([customerId, requestKey])
}

model BookingItem {
  id        String @id @default(cuid())
  bookingId String
  variantId String
  quantity  Int
  returnedQuantity Int @default(0)

  // Snapshots preserve what the customer booked, even if catalog data changes.
  productNameSnap  String          @db.VarChar(120)
  sizeSnapshot     String          @db.VarChar(80)
  categorySnapshot ProductCategory

  // Total line amounts for the full rental period, including quantity.
  rentalMinor  BigInt
  depositMinor BigInt @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  unitBlocks InventoryUnitBlock[]

  @@unique([bookingId, variantId])
  @@index([variantId, bookingId])
  @@index([bookingId])
}

// Each record represents one physical garment/accessory in the boutique.
model InventoryUnit {
  id        String              @id @default(cuid())
  variantId String
  code      String              @db.VarChar(100)
  status    InventoryUnitStatus @default(READY)
  version   Int                 @default(1)
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @db.Timestamptz(6)

  variant ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  blocks  InventoryUnitBlock[]
  events  InventoryUnitEvent[]

  @@unique([variantId, code])
  @@index([variantId, status, code])
}

// Booking blocks allocate a unit to one booking line. Offline and maintenance
// blocks use the same schedule so every stock-affecting operation checks the
// same physical piece and date range.
model InventoryUnitBlock {
  id            String                 @id @default(cuid())
  unitId        String
  bookingItemId String?
  type          InventoryUnitBlockType
  startsAt      DateTime               @db.Timestamptz(6)
  endsAt        DateTime               @db.Timestamptz(6)
  returnedAt    DateTime?              @db.Timestamptz(6)
  releasedAt    DateTime?              @db.Timestamptz(6)
  notes         String?                @db.VarChar(1000)
  createdById   String?
  createdAt     DateTime               @default(now()) @db.Timestamptz(6)

  unit        InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  bookingItem BookingItem?  @relation(fields: [bookingItemId], references: [id], onDelete: SetNull)
  createdBy   User?         @relation("InventoryUnitBlockActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([unitId, releasedAt, startsAt, endsAt])
  @@index([bookingItemId])
}

model InventoryUnitEvent {
  id           String              @id @default(cuid())
  unitId       String
  actorId      String?
  fromStatus   InventoryUnitStatus?
  toStatus     InventoryUnitStatus
  action       String              @db.VarChar(80)
  notes        String?             @db.VarChar(1000)
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)

  unit  InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  actor User?         @relation("InventoryUnitEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([unitId, createdAt])
  @@index([actorId, createdAt])
}

model BookingEvent {
  id         String             @id @default(cuid())
  bookingId  String
  actorId    String?
  action     BookingEventAction
  fromStatus BookingStatus?
  toStatus   BookingStatus?
  details    Json?
  createdAt  DateTime           @default(now()) @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation("BookingActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([actorId, createdAt])
}

model BookingInspection {
  id           String              @id @default(cuid())
  bookingId    String              @unique
  condition    InspectionCondition
  photos       String[]            @default([])
  notes        String?             @db.Text
  recordedById String
  recordedAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("InspectionRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([recordedById, recordedAt])
}

model ManualRefundRecord {
  id           String             @id @default(cuid())
  bookingId    String             @unique
  status       ManualRefundStatus @default(PENDING)
  amountMinor  BigInt?
  notes        String?            @db.Text
  recordedById String?
  recordedAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("RefundRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
}

// ---------- CUSTOMER FEATURES ----------

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String
  customerId String
  productId  String
  rating     Int
  comment    String?  @db.Text
  isHidden   Boolean  @default(false)
  moderationReason String? @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product  Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([customerId, productId, bookingId])
  @@unique([bookingId, productId])
  @@index([productId, createdAt])
  @@index([customerId, createdAt])
}

model Category {
  id String @id @default(cuid())
  slug String @unique @db.VarChar(120)
  name String @unique @db.VarChar(120)
  legacyKey ProductCategory? @unique
  isActive Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  products Product[]
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String @db.VarChar(120)
  entityType String @db.VarChar(80)
  entityId String?
  details Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([entityType, entityId])
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model AuthToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique @db.VarChar(64)
  type AuthTokenType
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type])
  @@index([expiresAt])
}

model RateLimitBucket {
  key String @id @db.VarChar(160)
  count Int @default(1)
  resetAt DateTime @db.Timestamptz(6)
  @@index([resetAt])
}

model BasketItem {
  id String @id @default(cuid())
  userId String
  variantId String
  quantity Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  @@unique([userId, variantId])
}

model BookingQuote {
  id String @id @default(cuid())
  userId String
  payload Json
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model Notification {
  id String @id @default(cuid())
  userId String
  bookingId String?
  dedupeKey String @unique @db.VarChar(200)
  type String @db.VarChar(50)
  title String @db.VarChar(160)
  message String @db.VarChar(2000)
  href String @db.VarChar(300)
  scheduledFor DateTime @default(now()) @db.Timestamptz(6)
  readAt DateTime? @db.Timestamptz(6)
  emailedAt DateTime? @db.Timestamptz(6)
  attempts Int @default(0)
  leaseUntil DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  @@index([userId, scheduledFor])
}

model SupportRequest {
  id String @id @default(cuid())
  userId String
  bookingId String?
  subject String @db.VarChar(160)
  message String @db.VarChar(3000)
  status String @default("OPEN") @db.VarChar(30)
  response String @default("") @db.VarChar(3000)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
