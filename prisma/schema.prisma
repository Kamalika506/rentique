generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum UserRole {
  CUSTOMER
  BOUTIQUE_OWNER
  ADMIN
}

enum BoutiqueStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductCategory {
  ETHNIC_WEAR
  WESTERN_WEAR
  FORMAL_WEAR
  PARTY_WEAR
  BRIDAL_WEAR
  ACCESSORIES
  FOOTWEAR
  OTHER
}

enum RentalPricingUnit {
  PER_DAY
  PER_RENTAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PICKED_UP
  RETURNED
  COMPLETED
  REJECTED
  CANCELLED
}

enum InspectionCondition {
  GOOD
  MINOR_DAMAGE
  MAJOR_DAMAGE
}

enum ManualRefundStatus {
  PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  WITHHELD
  NOT_REQUIRED
}

enum BookingEventAction {
  CREATED
  CONFIRMED
  REJECTED
  CANCELLED
  PICKED_UP
  RETURNED
  COMPLETED
  INSPECTION_RECORDED
  REFUND_UPDATED
  NOTE_ADDED
}

enum BoutiqueReviewAction {
  APPROVED
  REJECTED
  REOPENED
}

// ---------- AUTHENTICATION ----------

model User {
  id            String    @id @default(cuid())
  name          String?   @db.VarChar(120)
  email         String?   @unique @db.VarChar(254)
  emailVerified DateTime? @db.Timestamptz(6)
  image         String?   @db.Text

  // Used by email/password authentication.
  // Nullable because Google OAuth users need not have a password.
  passwordHash String? @db.VarChar(255)

  role     UserRole @default(CUSTOMER)
  phone    String?  @db.VarChar(32)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  accounts            Account[]
  sessions            Session[]
  boutique            Boutique?             @relation("BoutiqueOwner")
  boutiqueReviews     BoutiqueReviewEvent[] @relation("BoutiqueReviewEventReviewer")
  bookings            Booking[]             @relation("BookingCustomer")
  bookingEvents       BookingEvent[]        @relation("BookingActor")
  inspectionsRecorded BookingInspection[]   @relation("InspectionRecorder")
  refundsRecorded     ManualRefundRecord[]  @relation("RefundRecorder")
  wishlistItems       Wishlist[]
  reviews             Review[]
  reviewedBoutiques   Boutique[]            @relation("BoutiqueReviewedBy")

  @@index([role, isActive])
  @@index([createdAt])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String @db.VarChar(50)
  provider          String @db.VarChar(100)
  providerAccountId String @db.VarChar(191)

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String? @db.VarChar(100)
  scope         String? @db.Text
  id_token      String? @db.Text
  session_state String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @db.VarChar(255)
  userId       String
  expires      DateTime @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String   @db.VarChar(254)
  token      String   @unique @db.VarChar(255)
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@index([expires])
}

// ---------- BOUTIQUE MANAGEMENT ----------

model Boutique {
  id      String @id @default(cuid())
  ownerId String @unique

  name         String            @db.VarChar(120)
  description  String            @db.Text
  contactEmail String            @db.VarChar(254)
  phone        String            @db.VarChar(32)
  address      String            @db.VarChar(300)
  city         String            @db.VarChar(120)
  state        String            @db.VarChar(120)
  postalCode   String            @db.VarChar(12)
  categories   ProductCategory[]
  socialLink   String?           @db.VarChar(300)

  status          BoutiqueStatus @default(PENDING)
  rejectionReason String?        @db.Text
  submittedAt     DateTime       @default(now()) @db.Timestamptz(6)
  reviewedAt      DateTime?      @db.Timestamptz(6)
  reviewedById    String?
  timezone        String         @default("Asia/Kolkata") @db.VarChar(64)
  version         Int            @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  owner      User  @relation("BoutiqueOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("BoutiqueReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewEvents BoutiqueReviewEvent[]
  products     Product[]
  bookings     Booking[]

  @@index([status, submittedAt])
  @@index([city, state, status])
  @@index([reviewedById])
}

model BoutiqueReviewEvent {
  id         String               @id @default(cuid())
  boutiqueId String
  reviewerId String
  action     BoutiqueReviewAction
  reason     String?              @db.Text
  createdAt  DateTime             @default(now()) @db.Timestamptz(6)

  boutique Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  reviewer User     @relation("BoutiqueReviewEventReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([boutiqueId, createdAt])
  @@index([reviewerId, createdAt])
}

// ---------- PRODUCT CATALOG ----------

model Product {
  id         String @id @default(cuid())
  boutiqueId String

  name         String          @db.VarChar(120)
  description  String          @db.Text
  category     ProductCategory
  occasionTags String[]        @default([])
  colours      String[]        @default([])
  fabricStyle  String          @db.VarChar(200)

  // Prices are integer paise, never floating-point currency.
  rentalPriceMinor BigInt
  rentalPriceUnit  RentalPricingUnit @default(PER_DAY)
  depositMinor     BigInt            @default(0)

  archived Boolean @default(false)
  version  Int     @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  boutique      Boutique         @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  variants      ProductVariant[]
  images        ProductImage[]
  wishlistItems Wishlist[]
  reviews       Review[]

  @@index([boutiqueId, archived, createdAt])
  @@index([category, archived])
  @@index([archived, createdAt])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  // Example: S, M, L, XL, UK-8.
  size     String  @db.VarChar(80)
  sku      String? @unique @db.VarChar(100)
  quantity Int

  // Optional overrides for this size/SKU.
  rentalPriceMinor BigInt?
  depositMinor     BigInt?

  archived Boolean @default(false)
  version  Int     @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@unique([productId, size])
  @@index([productId, archived])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  publicId  String   @db.VarChar(255)
  secureUrl String   @db.Text
  alt       String   @db.VarChar(160)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([productId])
}

// ---------- RENTAL BOOKINGS ----------

model Booking {
  id         String        @id @default(cuid())
  boutiqueId String
  customerId String
  status     BookingStatus @default(PENDING)

  // Rental interval: pickupAt inclusive, returnAt exclusive.
  pickupAt DateTime @db.Timestamptz(6)
  returnAt DateTime @db.Timestamptz(6)

  rentalMinor  BigInt
  depositMinor BigInt @default(0)
  currency     String @default("INR") @db.VarChar(3)

  rejectionReason    String? @db.Text
  cancellationReason String? @db.Text

  pickedUpAt  DateTime? @db.Timestamptz(6)
  returnedAt  DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)

  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  boutique     Boutique            @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  customer     User                @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  items        BookingItem[]
  events       BookingEvent[]
  inspection   BookingInspection?
  refundRecord ManualRefundRecord?
  review       Review?

  @@index([customerId, createdAt])
  @@index([boutiqueId, status, createdAt])
  @@index([status, pickupAt, returnAt])
  @@index([boutiqueId, pickupAt, returnAt])
}

model BookingItem {
  id        String @id @default(cuid())
  bookingId String
  variantId String
  quantity  Int

  // Snapshots preserve what the customer booked, even if catalog data changes.
  productNameSnap  String          @db.VarChar(120)
  sizeSnapshot     String          @db.VarChar(80)
  categorySnapshot ProductCategory

  // Total line amounts for the full rental period, including quantity.
  rentalMinor  BigInt
  depositMinor BigInt @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([bookingId, variantId])
  @@index([variantId, bookingId])
  @@index([bookingId])
}

model BookingEvent {
  id         String             @id @default(cuid())
  bookingId  String
  actorId    String?
  action     BookingEventAction
  fromStatus BookingStatus?
  toStatus   BookingStatus?
  details    Json?
  createdAt  DateTime           @default(now()) @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation("BookingActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([actorId, createdAt])
}

model BookingInspection {
  id           String              @id @default(cuid())
  bookingId    String              @unique
  condition    InspectionCondition
  notes        String?             @db.Text
  recordedById String
  recordedAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("InspectionRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([recordedById, recordedAt])
}

model ManualRefundRecord {
  id           String             @id @default(cuid())
  bookingId    String             @unique
  status       ManualRefundStatus @default(PENDING)
  amountMinor  BigInt?
  notes        String?            @db.Text
  recordedById String?
  recordedAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("RefundRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
}

// ---------- CUSTOMER FEATURES ----------

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  customerId String
  productId  String
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product  Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([customerId, productId, bookingId])
  @@index([productId, createdAt])
  @@index([customerId, createdAt])
}
