# PostgreSQL
DATABASE_URL=

# Authentication
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Use HTTPS when deployed. Local example: http://localhost:3000
APP_URL=
# Auth.js behind a trusted reverse proxy; set only when proxy headers are trusted
AUTH_TRUST_HOST=
# Your existing administrator email; provision it with npm run admin:provision
ADMIN_EMAIL=
# Enable only after outgoing email is working
# This flag affects sign-in. Reservations always require a verified email.
REQUIRE_EMAIL_VERIFICATION=false
# Configure outgoing mail for reservation verification and email reminders. Gmail example:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Gmail app password, never your regular Google password
SMTP_PASSWORD=
# Optional; defaults to SMTP_USER
EMAIL_FROM=

# Cloudinary (server only; never prefix API_SECRET with NEXT_PUBLIC_)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Restricted signed image preset configured by the backend (JPG/PNG/WebP, 5 MB)
CLOUDINARY_SIGNED_UPLOAD_PRESET=

# Gemini AI (server only; never use NEXT_PUBLIC_)
GEMINI_API_KEY=
# Supported structured-output model ID configured for your Google account
GEMINI_MODEL=
# Optional image-capable model override; otherwise GEMINI_MODEL is used.
GEMINI_VISION_MODEL=

# At least 32 random characters. Schedule POST /api/internal/notifications
# every 5 minutes with Authorization: Bearer <JOBS_SECRET>.
# Alternatively schedule npm run jobs:reservations in a trusted worker.
JOBS_SECRET=
